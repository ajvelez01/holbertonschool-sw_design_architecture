classDiagram
    class Library {
        +add_book()
        +register_user()
        +create_loan()
    }
    class Book {
        +title: str
        +author: str
        +available: bool
        +mark_as_unavailable()
        +mark_as_available()
    }
    class User {
        +name: str
        +email: str
    }
    class Loan {
        +start_date
        +end_date
        +close_loan()
    }
    Library "1" o-- "0..*" Book : contains
    Library "1" o-- "0..*" User : registers
    Library "1" o-- "0..*" Loan : manages
    Loan "0..*" --> "1" Book : references
    Loan "0..*" --> "1" User : references
